DATABASE_URL="postgresql://user:password@localhost:5432/stitchos?schema=public"
# Production only: an unpooled connection string, used by `prisma migrate
# deploy` during the Vercel build. Falls back to DATABASE_URL if unset —
# only needed when DATABASE_URL itself is a pooled (pgbouncer) connection.
DIRECT_URL=""

AUTH_SECRET="generate-a-random-secret-for-production"
NEXTAUTH_URL="http://localhost:3000"

# "local" (filesystem, dev only) or "vercel-blob" (production). Auto-selects
# "vercel-blob" if BLOB_READ_WRITE_TOKEN is set, so this rarely needs to be
# set explicitly — Vercel's Blob storage integration sets that token itself.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/artwork"
BLOB_READ_WRITE_TOKEN=""

# Public embroidery configurator. Pin intake to the intended tenant and CRM
# owner instead of relying on the first database records. The upload secret
# signs short-lived browser-to-Blob intents; use an independent random value
# in production (AUTH_SECRET is used only as a fallback).
STITCHOS_PUBLIC_ORGANIZATION_ID="org_demo"
STITCHOS_PUBLIC_OWNER_EMAIL="admin@stitchos.dev"
CONFIGURATOR_UPLOAD_SECRET="generate-an-independent-random-secret"

# Optional server-to-server access for the legacy /api/public/commission
# endpoint and trusted external intake clients. Never expose this value in a
# NEXT_PUBLIC_* variable or in browser code.
STITCHOS_INTAKE_SECRET=""
