DATABASE_URL="postgresql://user:password@localhost:5432/stitchos?schema=public"
# Production only: an unpooled connection string, used by `prisma migrate
# deploy` during the Vercel build. Falls back to DATABASE_URL if unset —
# only needed when DATABASE_URL itself is a pooled (pgbouncer) connection.
DIRECT_URL=""

AUTH_SECRET="generate-a-random-secret-for-production"
NEXTAUTH_URL="http://localhost:3000"

# "local" (filesystem, dev only) or "vercel-blob" (production). Auto-selects
# "vercel-blob" if BLOB_READ_WRITE_TOKEN is set, so this rarely needs to be
# set explicitly — Vercel's Blob storage integration sets that token itself.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/artwork"
BLOB_READ_WRITE_TOKEN=""
